# Local settings and secrets for deploy/compose.yaml.
# Copy to inference-engine.env (git-ignored) and keep it out of version control.
# Any IE_* setting from config.example.toml can be set here.
#
# API keys are NOT configured here: create them after startup with
#   docker compose -f deploy/compose.yaml exec inference-engine \
#     inference-engine keys create --label owner

# Preload a model on every start (optional; otherwise load it from /dashboard):
# IE_MODEL_PATH=/data/models/model.gguf
# IE_MODEL_ID=my-model

# Restrict callers to trusted networks (optional):
# IE_IP_ALLOWLIST=["10.0.0.0/8"]
